<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows because WsusDeliveryAdapter references the WSUS Administration API,
         which is Windows-only. If you later want a pure-cross-platform Shared assembly for the
         Function App side, split WsusDeliveryAdapter out into its own small project instead. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Phylax.Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Azure.Core" Version="1.44.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same reference pattern as the existing Phylax.Connector.csproj -->
    <Reference Include="Microsoft.UpdateServices.Administration">
      <HintPath>C:\Program Files\Update Services\Api\Microsoft.UpdateServices.Administration.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
