<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Phylax.WsusPublisher</RootNamespace>
    <AssemblyName>Phylax.WsusPublisher</AssemblyName>
    <!-- Deliberately NO Nullable/ImplicitUsings and no Microsoft.Extensions.* packages.
         Keeping this project's dependency surface minimal is the entire point. It exists
         only because Microsoft.UpdateServices.Administration cannot be loaded from .NET 8
         (verified 2026-08-16: identical probe code connects fine on net48, throws
         FileNotFoundException on net8.0-windows). Everything else stays in the net8 connector. -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.UpdateServices.Administration">
      <HintPath>C:\Program Files\Update Services\Api\Microsoft.UpdateServices.Administration.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>